<?xml version="1.0" encoding="utf-8"?>
<!--  Copyright CANON INC. 2019 All Rights Reserved -->
<!--  CPCA to Bidi Extension file(Generic Plus Related) -->
<!--  Version 1.5.0.2 -->
<bidi:Definition xmlns:bidi="http://schemas.microsoft.com/windows/2005/03/printing/bidi">
  <Schema>
    <Property name="Printer">
      <Property name="Canon">
        <Property name="OIP">
          <!-- DEVICE -->
          <Property name="Device">
            <Value name="DeviceModelNameCode" acquire="deviceModel" filter="AcquireData[@name='deviceModel']/ResponseParam/STRING8_CODE_SET/Code" type="BIDI_INT" />
            <Value name="DeviceModelName" acquire="deviceModel" filter="AcquireData[@name='deviceModel']/ResponseParam/STRING8_CODE_SET/String" type="BIDI_STRING" />
            <Property name="Specification">
              <Value name="Data1"  acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data1" type="BIDI_STRING" />
              <Value name="Data2"  acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data2" type="BIDI_INT" />
              <Value name="Data3"  acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data3" type="BIDI_INT" />
              <Value name="Data40" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data40" type="BIDI_INT" />
              <Value name="Data41" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data41" type="BIDI_INT" />
              <Value name="Data42" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data42" type="BIDI_INT" />
              <Value name="Data43" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data43" type="BIDI_INT" />
              <Value name="Data44" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data44" type="BIDI_INT" />
              <Value name="Data45" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data45" type="BIDI_INT" />
              <Value name="Data46" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data46" type="BIDI_INT" />
              <Value name="Data47" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/UUID/Data47" type="BIDI_INT" />
              <Value name="Version" acquire="deviceSpecificationId" filter="AcquireData[@name='deviceSpecificationId']/ResponseParam/DEVICE_SPECIFICATION_ID/Version" type="BIDI_INT" />
            </Property>     
            <Property name="FirmwareVersion_Binary">
              <Value name="Data"    acquire="firmwareVersion_Binary" filter="AcquireData[@name='firmwareVersion_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="TrayInfo2_Binary">
              <Value name="Data" acquire="trayInfo2_Binary" filter="AcquireData[@name='trayInfo2_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="MediaState_Binary">
              <Value name="Data" acquire="mediaState_Binary" filter="AcquireData[@name='mediaState_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="ComponentState_Binary">
              <Value name="Data" acquire="componentState_Binary" filter="AcquireData[@name='componentState_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="OptionalUnits_Binary">
              <Value name="Data" acquire="optionalUnits_Binary" filter="AcquireData[@name='optionalUnits_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="MediumSupported_Binary">
              <Value name="Data" acquire="mediumSupported_Binary" filter="AcquireData[@name='mediumSupported_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="ColorMode_Binary">
              <Value name="Data" acquire="colorMode_Binary" filter="AcquireData[@name='colorMode_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="ColorMode2_Binary">
              <Value name="Data" acquire="colorMode2_Binary" filter="AcquireData[@name='colorMode2_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
			<Property name="OutputsSupported_Binary">
			  <Value name="Data" acquire="outputsSupported_Binary" filter="AcquireData[@name='outputsSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="DuplexUnit_Binary">
              <Value name="Data" acquire="plexesSupported_Binary" filter="AcquireData[@name='plexesSupported_Binary']/ResponseParam/Data"  type="BIDI_STRING"/>
            </Property>
            <Property name="FinishingInfo_Binary">
              <Value name="Data" acquire="finishingInfo_Binary" filter="AcquireData[@name='finishingInfo_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="FinishingUnitInfo_Binary">
              <Value name="Data" acquire="finishingUnitInfo_Binary" filter="AcquireData[@name='finishingUnitInfo_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
			<Property name="FinishingUnitInfo2_Binary">
              <Value name="Data" acquire="finishingUnitInfo2_Binary" filter="AcquireData[@name='finishingUnitInfo2_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Property name="DeckName_Binary">
              <Value name="Data" acquire="feedingUnitInfo_Binary" filter="AcquireData[@name='feedingUnitInfo_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="FeedingUnitInfo2_Binary">
              <Value name="Data" acquire="feedingUnitInfo2_Binary" filter="AcquireData[@name='feedingUnitInfo2_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="OutputBinInfo2_Binary">
              <Value name="Data" acquire="outputBinInfo2_Binary" filter="AcquireData[@name='outputBinInfo2_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="FinisherInfo2_Binary">
              <Value name="Data" acquire="finisherInfo2_Binary" filter="AcquireData[@name='finisherInfo2_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="AuthenticationTypeSupported_Binary">
              <Value name="Data" acquire="authenticationTypeSupported_Binary" filter="AcquireData[@name='authenticationTypeSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Value name="UserManagementLevel" acquire="userManagementLevel" filter="AcquireData[@name='userManagementLevel']/ResponseParam/Security" type="BIDI_INT"/>
            <Property name="UserMustAuthentication">
              <Installed name="Supported" acquire="authentication" filter="AcquireData[@name='authentication']/ResponseParam[MustAuthentication='1']" />
            </Property>
            <Property name="ColorSupported">
              <Installed name="Supported" acquire="engineSpeed" filter="AcquireData[@name='engineSpeed']/ResponseParam/MAX_SPEED_LIST8/List[ID='3' or ID='4']" />
            </Property>
            <Property name="JobAttributes_Binary">
              <Value name="Data" acquire="jobAttributes_Binary" filter="AcquireData[@name='jobAttributes_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="BinderAttributes_Binary">
              <Value name="Data" acquire="binderAttributes_Binary" filter="AcquireData[@name='binderAttributes_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="DocumentAttributes_Binary">
              <Value name="Data" acquire="documentAttributes_Binary" filter="AcquireData[@name='documentAttributes_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="ComponentAttributes_Binary">
              <Value name="Data" acquire="componentAttributes_Binary" filter="AcquireData[@name='componentAttributes_Binary']/ResponseParam/Data" type="BIDI_STRING" />
            </Property>
            <Property name="Diename">
              <Value name="DieNumber"  acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/DieNumber" type="BIDI_INT"/>
              <Value name="Flag"       acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/Flag" type="BIDI_INT"/>
              <Value name="DetailInfo" acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/DetailInfo" type="BIDI_INT"/>
              <Property name="DieName">
                <Value name="Code"   acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/DieName/Code" type="BIDI_INT"/>
                <Value name="Count"  acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/DieName/Count" type="BIDI_INT"/>
                <Value name="String" acquire="diename" filter="AcquireData[@name='diename']/ResponseParam/DIE_INFO_1/DieName/String" type="BIDI_STRING"/>
              </Property>
            </Property>
            <Property name="EngineSpeed_Binary">
              <Value name="Data" acquire="engineSpeed_Binary" filter="AcquireData[@name='engineSpeed_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
            </Property>
            <Value name="MaxBinder" acquire="maxBinder" filter="AcquireData[@name='maxBinder']/ResponseParam/MaximumBinderCounts" type="BIDI_INT"/>
            <Property name="Locale_Binary">
              <Value name="Data" acquire="locale_Binary" filter="AcquireData[@name='locale_Binary']/ResponseParam/Data"  type="BIDI_STRING"/>
            </Property>
          </Property>

          <Property name="Printer">
            <Property name="Capability">
              <Property name="SecurePrintSupported">
                <Installed name="Supported" acquire="securePrint" filter="AcquireData[@name='securePrint']/ResponseParam[JobPasswordSupported='1']" />
              </Property>
              <Property name="SecureSchedulePrint_Binary">
                <Value name="Data" acquire="secureSchedulePrint_Binary" filter="AcquireData[@name='secureSchedulePrint_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="InterruptPrint_Binary">
                <Value name="Data" acquire="jobExecutionModesOfJobStartSupported_Binary" filter="AcquireData[@name='jobExecutionModesOfJobStartSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="Rotation_Binary">
                <Value name="Data" acquire="rotation_Binary" filter="AcquireData[@name='rotation_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="BlurryImageCorrection_Binary">
                <Value name="Data" acquire="blurryImageCorrection_Binary" filter="AcquireData[@name='blurryImageCorrection_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="BarcodeAdjustment_Binary">
                <Value name="Data" acquire="barcodeAdjustment_Binary" filter="AcquireData[@name='barcodeAdjustment_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="InputTrayByCopiesSupported">
                <Installed name="Supported" acquire="carbonCopy" filter="AcquireData[@name='carbonCopy']/ResponseParam[InputTrayByCopiesSupported='1']" />
              </Property>
              <Property name="Resolution_Binary">
                <Value name="Data" acquire="resolutionsSupported_Binary" filter="AcquireData[@name='resolutionsSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="BiColorExtension_Binary">
                <Value name="Data" acquire="biColorExtension_Binary" filter="AcquireData[@name='biColorExtension_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="JobEncryptionInfoSupported_Binary">
                <Value name="Data" acquire="jobEncryptionInformationSupported_Binary" filter="AcquireData[@name='jobEncryptionInformationSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="UnicodeSupported_Binary">
                <Value name="Data" acquire="cpcaUnicodeSupported_Binary" filter="AcquireData[@name='cpcaUnicodeSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="TrustPrintMode">
                <Value name="Mode" acquire="trustPrintMode" filter="AcquireData[@name='trustPrintMode']/ResponseParam/Ubyte" type="BIDI_INT"/>
              </Property>
              <Property name="ICCProfileUseSupported_Binary">
                <Value name="Data" acquire="iccProfileUseSupported_Binary" filter="AcquireData[@name='iccProfileUseSupported_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>              
              <Property name="ColorOutputProfile_Binary">
                <Value name="Data" acquire="ColorOutputProfile_Binary" filter="AcquireData[@name='ColorOutputProfile_Binary']/ResponseParam/Data" type="BIDI_STRING"/>
              </Property>
              <Property name="WideColorGamutPrintModeAvailability">
                <Value name="Supported" acquire="popPrint" filter="AcquireData[@name='popPrint']/ResponseParam/WideColorGamutPrintModeAvailability" type="BIDI_INT"/>
              </Property>   			  
            </Property>
          </Property>
          
          <!-- Finishing -->
          <Property name="Finishing">
            <!-- MediaInfo -->
            <Property name="MediaInfo">
              <Property name="MediaInfoEntry">
                <Parameter name="$MediaInfoEntryId$" parameter="MediaInfoEntryId" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param/ParamIndex">
                  <Value name="MediaId" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/Medium" type="BIDI_INT"/>
                  <Value name="Name" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/BrandName/String" type="BIDI_STRING" />
                  <Value name="Weight" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/EngineParameters/Field/Weight" type="BIDI_INT" />
                  <Value name="Surface" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/EngineParameters/Field/Surface" type="BIDI_STRING"/>
                  <Value name="Shape" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/EngineParameters/Field/Shape" type="BIDI_STRING"/>
                  <Value name="Color" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/EngineParameters/Field/Color" type="BIDI_STRING"/>
                  <Value name="GutterShift" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/EngineParameters/Field/GutterShift" type="BIDI_INT" />
                </Parameter>
              </Property>
            </Property>
          </Property>
          
          <!-- Opretion: ListObjects2A -->
          <!-- ファイルボックス情報/FileBox -->
          <Property name="FileBox">
            <Property name="FileBoxEntry">
              <Parameter name="$FileBoxEntryId$" parameter="FileBoxEntryId" acquire="fileBox" filter="AcquireData[@name='fileBox']/Param/ParamIndex">
                <Value name="NameCode" acquire="fileBox" filter="AcquireData[@name='fileBox']/Param[ParamIndex='$FileBoxEntryId$']/ResponseParam/FileBoxName/Code" type="BIDI_INT" />
                <Value name="NameString" acquire="fileBox" filter="AcquireData[@name='fileBox']/Param[ParamIndex='$FileBoxEntryId$']/ResponseParam/FileBoxName/String" type="BIDI_STRING" />
                <Value name="Number" acquire="fileBox" filter="AcquireData[@name='fileBox']/Param[ParamIndex='$FileBoxEntryId$']/ResponseParam/FileBoxNumber" type="BIDI_INT" />
                <Value name="JobExecutePrint" acquire="fileBox" filter="AcquireData[@name='fileBox']/Param[ParamIndex='$FileBoxEntryId$']/ResponseParam/FileBoxJobExecutePrint" type="BIDI_INT" />
              </Parameter>
            </Property>
          </Property>
          <!-- RESOURCE -->
          <Property name="Resource">
            <!-- フォームファイル情報/FormFile -->
            <Property name="Form">
              <Property name="FormEntry">
                <Parameter name="$FormEntryId$" parameter="FormEntryId" acquire="form" filter="AcquireData[@name='form']/Param/ParamIndex">
                  <Value name="ObjectHandle" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/ObjectHandle/HandleValue" type="BIDI_STRING" />
                  <Value name="NameCode" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/formName/Code" type="BIDI_INT" />
                  <Value name="NameString" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/formName/String" type="BIDI_STRING" />
                  <Value name="CreatedDate" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/DateTimes/Date" type="BIDI_INT"/>
                  <Value name="CreatedTime" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/DateTimes/Time" type="BIDI_INT"/>
                  <Value name="FileListHandles" acquire="form" filter="AcquireData[@name='form']/Param[ParamIndex='$FormEntryId$']/ResponseParam/HandleList/HandleList/Handle" type="BIDI_STRING" />
                </Parameter>
              </Property>
            </Property>
            <!--ICCプロファイル情報/ICC Profile -->
            <Property name="ICCProfile">
              <Property name="ICCProfileEntry">
                <Parameter name="$ICCProfileEntryId$" parameter="ICCProfileEntryId" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param/ParamIndex">
                  <Value name="ICCProfileNameCodeSet" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/iccprofileName/Code" type="BIDI_INT" />
                  <Value name="ICCProfileName" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/iccprofileName/String" type="BIDI_STRING" />
                  <Value name="UsedFlag" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/usedFlag" type="BIDI_INT" />
                  <Value name="NameSwitchFlagOriginal" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/nameswitchFlag/SwitchFlagOriginal" type="BIDI_INT" />
                  <Value name="NameSwitchFlagGroup" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/nameswitchFlag/SwitchFlagGroup" type="BIDI_INT" />
                  <Value name="ColorSpace" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/colorspaceData" type="BIDI_INT" />
                  <Value name="CodeSet" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/codesetName/CodeSet" type="BIDI_INT" />
                  <Value name="ResourceState" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/resourceState/State" type="BIDI_INT" />
                  <Value name="InnerFileNameCodeSet" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/innerfileName/Code" type="BIDI_INT" />
                  <Value name="InnerFileName" acquire="iccprofile" filter="AcquireData[@name='iccprofile']/Param[ParamIndex='$ICCProfileEntryId$']/ResponseParam/innerfileName/String" type="BIDI_STRING" />
                </Parameter>
              </Property>
            </Property>
            <!--D-Half情報/D-Half-->
            <!--キャリブレーション情報/Calibration-->
            <Property name="DHalf">
              <Property name="DHalfEntry">
                <Parameter name="$DHalfEntryId$" parameter="DHalfEntryId" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param/ParamIndex">
                  <Value name="CodeSet" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/codesetName" type="BIDI_STRING" />
                  <Value name="TimeStamp" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/timestamp" type="BIDI_STRING" />
                  <Value name="Type" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/type" type="BIDI_STRING" />
                  <Value name="Data" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/data/Count" type="BIDI_STRING" />
                  <Value name="Resolution" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/resolution" type="BIDI_STRING" />
                  <Value name="MediumType" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/mediumype" type="BIDI_STRING" />
                  <Value name="InputDataDepth" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/inputdepth" type="BIDI_STRING" />
                  <Value name="OutputDataDepth" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/outputdepth" type="BIDI_STRING" />
                  <Value name="HalfToneOutputDataDepth" acquire="dhalf" filter="AcquireData[@name='dhalf']/Param[ParamIndex='$DHalfEntryId$']/ResponseParam/halfoutputdepth" type="BIDI_STRING" />
                </Parameter>
              </Property>
            </Property>
            <!--カスタムダウンロードプロファイル情報/Custom Download Profile-->
            <Property name="CustomDownloadProfile">
              <Property name="CustomProfileEntry">
                <Parameter name="$CustomProfileEntryId$" parameter="CustomProfileEntryId" acquire="customprofile" filter="AcquireData[@name='customprofile']/Param/ParamIndex">
                  <Value name="NameCode" acquire="customprofile" filter="AcquireData[@name='customprofile']/Param[ParamIndex='$CustomProfileEntryId$']/ResponseParam/name/Code" type="BIDI_INT" />
                  <Value name="Name" acquire="customprofile" filter="AcquireData[@name='customprofile']/Param[ParamIndex='$CustomProfileEntryId$']/ResponseParam/name/String" type="BIDI_STRING" />
                  <Value name="State" acquire="customprofile" filter="AcquireData[@name='customprofile']/Param[ParamIndex='$CustomProfileEntryId$']/ResponseParam/State" type="BIDI_INT" />
                  <Value name="CodeSet" acquire="customprofile" filter="AcquireData[@name='customprofile']/Param[ParamIndex='$CustomProfileEntryId$']/ResponseParam/codesetName" type="BIDI_INT" />
                </Parameter>
              </Property>
            </Property>
          </Property>

          <!-- MediaInfo2_2 XPS Style-->
          <Property name="MediaInformation">
            <Property name="MediaInformationEntry">
              <Parameter name="$MediaInformationEntryId$" parameter="MediaInformationEntryId" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param/ParamIndex">
                <Value name="MediaId" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/Medium" type="BIDI_INT"/>
                <Value name="Name" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/BrandName/String" type="BIDI_STRING" />
                <Value name="Weight" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/EngineParameters/Field/Weight" type="BIDI_INT" />
                <Value name="Surface" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/EngineParameters/Field/Surface" type="BIDI_STRING"/>
                <Value name="Shape" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/EngineParameters/Field/Shape" type="BIDI_STRING"/>
                <Value name="Color" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/EngineParameters/Field/Color" type="BIDI_STRING"/>
                <Value name="GutterShift" acquire="mediaInformation2_2" filter="AcquireData[@name='mediaInformation2_2']/Param[ParamIndex='$MediaInformationEntryId$']/ResponseParam/List/EngineParameters/Field/GutterShift" type="BIDI_INT" />
              </Parameter>
            </Property>
          </Property>

          <Property name="Media">
            <!-- MediumSupportInfo -->
            <Property name="MediumSupportInfo">
              <Property name="MediumSupportInfoEntry">
                <Parameter name="$MediumSupportInfoEntryId$" parameter="MediumSupportInfoEntryId" acquire="mediumSupportInfo" filter="AcquireData[@name='mediumSupportInfo']/Param/ParamIndex">                
                  <Value name="Type" acquire="mediumSupportInfo" filter="AcquireData[@name='mediumSupportInfo']/Param[ParamIndex='$MediumSupportInfoEntryId$']/ResponseParam/List/MediumID/Type" type="BIDI_INT" />
                  <Value name="Color" acquire="mediumSupportInfo" filter="AcquireData[@name='mediumSupportInfo']/Param[ParamIndex='$MediumSupportInfoEntryId$']/ResponseParam/List/MediumID/Color" type="BIDI_INT" />
                  <Value name="Size" acquire="mediumSupportInfo" filter="AcquireData[@name='mediumSupportInfo']/Param[ParamIndex='$MediumSupportInfoEntryId$']/ResponseParam/List/MediumID/Size" type="BIDI_INT" />
                  <Value name="Support" acquire="mediumSupportInfo" filter="AcquireData[@name='mediumSupportInfo']/Param[ParamIndex='$MediumSupportInfoEntryId$']/ResponseParam/List/Support" type="BIDI_INT" />
                </Parameter>
              </Property>
            </Property>
            <!-- MediaInfo -->
            <Property name="MediaInfo_Binary">
              <Property name="MediaInfoEntry">
                <Parameter name="$MediaInfoEntryId$" parameter="MediaInfoEntryId" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param/ParamIndex">
                  <Value name="Data" acquire="mediaInformation" filter="AcquireData[@name='mediaInformation']/Param[ParamIndex='$MediaInfoEntryId$']/ResponseParam/List/Data" type="BIDI_STRING" />
                </Parameter>
              </Property>
            </Property>
            <!-- MediaInfo2 -->
            <Property name="MediaInfo2_Binary">
